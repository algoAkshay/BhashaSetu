# Set in the process environment; this file is a template, not loaded automatically.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/bhashasetu
# Optional: disposable database for integration tests (creates a temporary schema).
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/bhashasetu_test

# ASR: official model access must be accepted on Hugging Face before first use.
ASR_PROVIDER=indicconformer
ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
ASR_LANGUAGE=hi
ASR_DECODER=ctc
ASR_LOG_TRANSCRIPTS=false
# Authenticate with `hf auth login` or supply HF_TOKEN securely in the environment.
# Never commit a token. No token value belongs in this template.
# FFMPEG_BINARY=C:\path\to\ffmpeg.exe
# Explicit rollback: ASR_PROVIDER=whisper and ASR_MODEL_ID=base (no automatic fallback).

# Phase 2: structured extraction only; eligibility still uses PostgreSQL rules.
LLM_PROVIDER=gemini
# Stable model with structured outputs, verified in Google's docs on 2026-09-19.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_MS=30000
# Supply the key securely in the server process environment. Never commit it.

# Phase 3: temporary conversational profiles; PostgreSQL still owns schemes/rules.
SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800
REDIS_KEY_PREFIX=bhashasetu:session
# rediss:// supports managed Redis TLS. Supply credentials securely, never commit.
# Explicit dev-only option: SESSION_BACKEND=memory (never an automatic fallback).
# TEST_REDIS_URL=redis://localhost:6379/15

# Optional lightweight admin panel. Supply both secrets securely in the process
# environment. No working passwords or signing keys belong in this template.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# ADMIN_SESSION_SECRET must contain at least 32 characters of random material.
# Enable on HTTPS deployments; leave false only for local HTTP development.
ADMIN_COOKIE_SECURE=false

# Request/audio protections: positive integers. Uploads are read in chunks.
MAX_AUDIO_UPLOAD_BYTES=8388608
MAX_AUDIO_DURATION_SECONDS=60
CONVERSATION_REQUESTS_PER_MINUTE=30
SPEECH_REQUESTS_PER_MINUTE=8
# Completed generated MP3s expire after this age (cleanup runs at least each minute).
AUDIO_CLEANUP_TTL_SECONDS=3600
# Failed attempts per client, then a temporary cooldown; successful login resets.
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_COOLDOWN_SECONDS=300
# Required for IndicConformer remote code: supply a reviewed immutable 40-character
# Hugging Face commit hash. No real revision is supplied here; missing configuration
# fails explicitly when loading the voice model. Text does not load the model.
ASR_MODEL_REVISION=
